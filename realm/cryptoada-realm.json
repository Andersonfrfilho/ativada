{
  "realm": "cryptoada",
  "displayName": "CryptoAdA",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "actionTokenGeneratedByAdminLifespan": 86400,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "adminPermissionsEnabled": true,
  "browserFlow": "browser-loa",
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "DENY",
    "xRobotsTag": "none",
    "referrerPolicy": "no-referrer",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@cryptoada.local",
    "fromDisplayName": "CryptoAdA",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "attributes": {
    "acr.loa.map": "{\"password\":1,\"mfa\":2}"
  },
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Usuario do produto (papel padrao)"
      },
      {
        "name": "admin",
        "description": "Administrador; atribuido so a mao no Keycloak"
      },
      {
        "name": "default-roles-cryptoada",
        "description": "Papel padrao do realm",
        "composite": true,
        "composites": {
          "realm": [
            "user"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-cryptoada",
    "description": "Papel padrao do realm"
  },
  "scopeMappings": [
    {
      "client": "cryptoada-session",
      "roles": [
        "user",
        "admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "cryptoada-api",
      "enabled": true,
      "protocol": "openid-connect",
      "consentRequired": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "bearerOnly": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "attributes": {}
    },
    {
      "clientId": "cryptoada-session",
      "enabled": true,
      "protocol": "openid-connect",
      "consentRequired": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "bearerOnly": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "${KEYCLOAK_PANEL_ORIGIN}/auth/callback"
      ],
      "webOrigins": [
        "${KEYCLOAK_PANEL_ORIGIN}"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KEYCLOAK_PANEL_ORIGIN}/"
      },
      "secret": "${KEYCLOAK_SESSION_CLIENT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "protocolMappers": [
        {
          "name": "audience-cryptoada-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "cryptoada-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "cryptoada-api-service",
      "enabled": true,
      "protocol": "openid-connect",
      "consentRequired": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {},
      "secret": "${KEYCLOAK_SERVICE_CLIENT_SECRET}",
      "clientAuthenticatorType": "client-secret"
    },
    {
      "clientId": "admin-permissions",
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "policies": [
          {
            "name": "cryptoada-api-service-policy",
            "type": "client",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "clients": "[\"cryptoada-api-service\"]"
            }
          },
          {
            "name": "cryptoada-api-service-users-manage",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Users",
              "resources": "[\"Users\"]",
              "scopes": "[\"manage\",\"view\"]",
              "applyPolicies": "[\"cryptoada-api-service-policy\"]"
            }
          },
          {
            "name": "not-cryptoada-api-service-policy",
            "type": "client",
            "logic": "NEGATIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "clients": "[\"cryptoada-api-service\"]"
            }
          },
          {
            "name": "cryptoada-api-service-cannot-manage-admins",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Groups",
              "resources": "[\"5b6f0c1e-7d3a-4c5e-9a0b-2f1d8e6c4a73\"]",
              "scopes": "[\"manage\",\"manage-members\"]",
              "applyPolicies": "[\"not-cryptoada-api-service-policy\"]"
            }
          }
        ],
        "resources": [
          {
            "name": "5b6f0c1e-7d3a-4c5e-9a0b-2f1d8e6c4a73",
            "type": "Groups",
            "scopes": [
              {
                "name": "manage"
              },
              {
                "name": "manage-members"
              }
            ]
          }
        ]
      }
    },
    {
      "clientId": "admin-cli",
      "name": "${client_admin-cli}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
