{
  "name": "cryptoada",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/frontend-cryptoada/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "bun test --timeout 60000",
    "test:full": "FULL_CONTRACT=1 bun test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6",
    "typescript-eslint": "^8.71.1"
  }
}
