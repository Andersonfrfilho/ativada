# Valores de DESENVOLVIMENTO local. Não são segredo real; nunca usar em produção.
PROJECT_NAME=cryptoada
ENV=dev
POSTGRES_PORT=56432
POSTGRES_USER=cryptoada
POSTGRES_PASSWORD=cryptoada_dev_only
POSTGRES_DB=cryptoada_dev
DATABASE_URL=postgres://cryptoada:cryptoada_dev_only@127.0.0.1:56432/cryptoada_dev
API_HOST=127.0.0.1
API_PORT=56101
VITE_API_URL=http://127.0.0.1:56101
# Keycloak e Mailpit (valores de desenvolvimento, nao secretos; producao usa segredos proprios)
KEYCLOAK_PORT=56180
MAILPIT_SMTP_PORT=56125
MAILPIT_UI_PORT=56126
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cryptoada_dev_admin_only
KEYCLOAK_SESSION_CLIENT_SECRET=crypto_session_dev_only
KEYCLOAK_SERVICE_CLIENT_SECRET=crypto_service_dev_only
KEYCLOAK_PANEL_ORIGIN=http://127.0.0.1:56100
# API: validação do JWT, CORS e proxies (ADR 0001 §b)
KEYCLOAK_ISSUER=http://127.0.0.1:56180/realms/cryptoada
KEYCLOAK_JWKS_URL=http://127.0.0.1:56180/realms/cryptoada/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://127.0.0.1:56180/realms/cryptoada/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URL=http://127.0.0.1:56180/realms/cryptoada/protocol/openid-connect/logout
KEYCLOAK_SESSION_CLIENT_ID=cryptoada-session
KEYCLOAK_ADMIN_API_URL=http://127.0.0.1:56180/admin/realms/cryptoada
KEYCLOAK_SERVICE_CLIENT_ID=cryptoada-api-service
SESSION_ALLOWED_REDIRECT_URIS=http://127.0.0.1:56100/auth/callback
API_AUDIENCE=cryptoada-api
AUTHORIZED_PARTIES=cryptoada-session
CORS_ALLOWED_ORIGINS=http://127.0.0.1:56100
TRUSTED_PROXY_HOPS=0
# Telegram (valores FALSOS de desenvolvimento; o bot real usa segredos próprios)
TELEGRAM_BOT_TOKEN=123456789:FAKE_dev_token_only_for_local_use
TELEGRAM_WEBHOOK_SECRET=fake_dev_webhook_secret_only_0001
TELEGRAM_API_BASE_URL=http://127.0.0.1:56104
# Mercado (cron): exchange, pares, timeframes, anos de backfill e host público de dados da Binance
MARKET_EXCHANGE=binance
MARKET_SYMBOLS=BTCUSDT,ETHUSDT
MARKET_TIMEFRAMES=15m,1h,4h,1d
BACKFILL_YEARS=2
BINANCE_BASE_URL=https://data-api.binance.vision
FEAR_GREED_API_URL=https://api.alternative.me/fng/
FEAR_GREED_REFRESH_DAYS=14
# Worker: stream combinado de klines (host só de dados de mercado) e silêncio máximo antes de reconectar
BINANCE_STREAM_URL=wss://data-stream.binance.vision
STREAM_STALE_SECONDS=60
# Worker: janela de retrocesso da verificação de lacunas (horas) e intervalo da verificação periódica (minutos)
STREAM_GAP_LOOKBACK_HOURS=168
STREAM_GAP_CHECK_MINUTES=15
