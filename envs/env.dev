# Valores de DESENVOLVIMENTO local. Não são segredo real; nunca usar em produção.
PROJECT_NAME=ativada
ENV=dev
POSTGRES_PORT=56432
POSTGRES_USER=ativada
POSTGRES_PASSWORD=ativada_dev_only
POSTGRES_DB=ativada_dev
DATABASE_URL=postgres://ativada:ativada_dev_only@127.0.0.1:56432/ativada_dev
API_HOST=127.0.0.1
API_PORT=56101
VITE_API_URL=http://127.0.0.1:56101
VITE_KEYCLOAK_AUTHORIZE_URL=http://127.0.0.1:56180/realms/ativada/protocol/openid-connect/auth
PANEL_PORT=56100
# Keycloak e Mailpit (valores de desenvolvimento, nao secretos; producao usa segredos proprios)
KEYCLOAK_PORT=56180
MAILPIT_SMTP_PORT=56125
MAILPIT_UI_PORT=56126
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=ativada_dev_admin_only
KEYCLOAK_SESSION_CLIENT_SECRET=ativada_session_dev_only
KEYCLOAK_SERVICE_CLIENT_SECRET=ativada_service_dev_only
KEYCLOAK_PANEL_ORIGIN=http://127.0.0.1:56100
# API: validação do JWT, CORS e proxies (ADR 0001 §b)
KEYCLOAK_ISSUER=http://127.0.0.1:56180/realms/ativada
KEYCLOAK_JWKS_URL=http://127.0.0.1:56180/realms/ativada/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://127.0.0.1:56180/realms/ativada/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URL=http://127.0.0.1:56180/realms/ativada/protocol/openid-connect/logout
KEYCLOAK_SESSION_CLIENT_ID=ativada-session
KEYCLOAK_ADMIN_API_URL=http://127.0.0.1:56180/admin/realms/ativada
KEYCLOAK_SERVICE_CLIENT_ID=ativada-api-service
SESSION_ALLOWED_REDIRECT_URIS=http://127.0.0.1:56100/auth/callback
API_AUDIENCE=ativada-api
AUTHORIZED_PARTIES=ativada-session
CORS_ALLOWED_ORIGINS=http://127.0.0.1:56100
TRUSTED_PROXY_HOPS=0
# Telegram (valores FALSOS de desenvolvimento; o bot real usa segredos próprios)
TELEGRAM_BOT_TOKEN=123456789:FAKE_dev_token_only_for_local_use
TELEGRAM_WEBHOOK_SECRET=fake_dev_webhook_secret_only_0001
TELEGRAM_API_BASE_URL=http://127.0.0.1:56104
# Mercado (cron): exchange, pares, timeframes, anos de backfill e host público de dados da Binance
MARKET_EXCHANGE=binance
MARKET_SYMBOLS=BTCUSDT,ETHUSDT
MARKET_TIMEFRAMES=15m,1h,4h,1d
# Velas de exibição (spec 017): 1m e 3m gravadas com retenção curta (nunca timeframe de execução); vazio desliga
MARKET_DISPLAY_TIMEFRAMES=1m,3m
CANDLE_DISPLAY_RETENTION_DAYS=90
CANDLE_DISPLAY_1M_RETENTION_DAYS=30
BACKFILL_YEARS=2
BINANCE_BASE_URL=https://data-api.binance.vision
FEAR_GREED_API_URL=https://api.alternative.me/fng/
FEAR_GREED_REFRESH_DAYS=14
# Worker: stream combinado de klines (host só de dados de mercado) e silêncio máximo antes de reconectar
BINANCE_STREAM_URL=wss://data-stream.binance.vision
STREAM_STALE_SECONDS=60
# Worker: janela de retrocesso da verificação de lacunas (horas) e intervalo da verificação periódica (minutos)
STREAM_GAP_LOOKBACK_HOURS=168
STREAM_GAP_CHECK_MINUTES=15
# API: tempo real (WebSocket). Tetos por usuário e por socket. O ticker lê SÓ preços públicos da Binance (sem chave, sem conta);
# TICKER_KLINE_ENABLED só vale com TICKER_STREAM_ENABLED=true (a vela em formação viaja pela mesma conexão do preço)
STREAM_MAX_SOCKETS_PER_USER=5
STREAM_MAX_PAIRS_PER_SOCKET=10
# API: multiplica o teto de pedidos por minuto de cada política (vários agentes e abas dividem o usuário de teste). Só vale com ENV=dev.
RATE_LIMIT_MULTIPLIER=4
TICKER_STREAM_ENABLED=true
TICKER_KLINE_ENABLED=true
TICKER_STALE_SECONDS=10

# Equipes de modelo (spec 015). Desligadas sem chave. A chave real vai SÓ em envs/env.dev.local (a I.A. nunca abre esse arquivo).
# O id do modelo e o preço por milhão de tokens são obrigatórios com a chave e não têm padrão no código.
# ANTHROPIC_API_KEY=
# MODEL_TEAM_LUCAS_MODEL=
# MODEL_TEAM_LUCAS_INPUT_USD_PER_MTOK=
# MODEL_TEAM_LUCAS_OUTPUT_USD_PER_MTOK=
# GEMINI_API_KEY=
# MODEL_TEAM_NINA_MODEL=
# MODEL_TEAM_NINA_INPUT_USD_PER_MTOK=
# MODEL_TEAM_NINA_OUTPUT_USD_PER_MTOK=
# OPENAI_API_KEY=
# MODEL_TEAM_OLIVIA_MODEL=
# MODEL_TEAM_OLIVIA_INPUT_USD_PER_MTOK=
# MODEL_TEAM_OLIVIA_OUTPUT_USD_PER_MTOK=
# Tetos de custo (obrigatórios com qualquer chave): US$ 2 por dia e US$ 50 por mês; ritmo de 60 min (15 ou 60).
# MODEL_TEAM_DAILY_BUDGET_USD=2
# MODEL_TEAM_MONTHLY_BUDGET_USD=50
# MODEL_TEAM_CADENCE_MINUTES=60
# Pergunta por voz: transcrição LOCAL com whisper.cpp (o áudio nunca sai da máquina). `off` desliga (a rota responde 503).
TRANSCRIPTION_ENGINE=whisper_local
WHISPER_CLI_PATH=~/.local/bin/whisper-cli
WHISPER_MODEL_PATH=~/.local/share/whisper/ggml-large-v3-turbo.bin
# whisper-cli usa 4 threads por padrão; com 16 a pergunta curta cai de ~14 s para ~8 s nesta máquina (CPU, sem GPU).
WHISPER_THREADS=16
