KEYCLOAK_SERVICE_CLIENT_SECRET=crypto_service_test_only
KEYCLOAK_PANEL_ORIGIN=http://127.0.0.1:56103
# API: validação do JWT, CORS e proxies (ADR 0001 §b)
KEYCLOAK_ISSUER=http://127.0.0.1:56181/realms/crypto-paper-trader
KEYCLOAK_JWKS_URL=http://127.0.0.1:56181/realms/crypto-paper-trader/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://127.0.0.1:56181/realms/crypto-paper-trader/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URL=http://127.0.0.1:56181/realms/crypto-paper-trader/protocol/openid-connect/logout
KEYCLOAK_SESSION_CLIENT_ID=crypto-session
KEYCLOAK_ADMIN_API_URL=http://127.0.0.1:56181/admin/realms/crypto-paper-trader
KEYCLOAK_SERVICE_CLIENT_ID=crypto-api-service
SESSION_ALLOWED_REDIRECT_URIS=http://127.0.0.1:56103/auth/callback
API_AUDIENCE=crypto-api
AUTHORIZED_PARTIES=crypto-session
CORS_ALLOWED_ORIGINS=http://127.0.0.1:56103
