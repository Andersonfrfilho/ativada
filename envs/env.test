# Valores de TESTE local. Não são segredo real; nunca usar em produção.
PROJECT_NAME=crypto-paper-trader
ENV=test
POSTGRES_PORT=56433
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto_test_only
POSTGRES_DB=crypto_test
DATABASE_URL=postgres://crypto:crypto_test_only@127.0.0.1:56433/crypto_test
API_HOST=127.0.0.1
API_PORT=56102
VITE_API_URL=http://127.0.0.1:56102
# Keycloak e Mailpit (valores de desenvolvimento, nao secretos; producao usa segredos proprios)
KEYCLOAK_PORT=56181
MAILPIT_SMTP_PORT=56127
MAILPIT_UI_PORT=56128
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=crypto_test_admin_only
