# Simulação ao vivo de 72 h (T6.3): infra de DESENVOLVIMENTO dedicada, portas próprias (565xx).
# Valores de DESENVOLVIMENTO local. Não são segredo real; nunca usar em produção.
PROJECT_NAME=ativada-live72
ENV=dev
POSTGRES_PORT=56532
POSTGRES_USER=ativada
POSTGRES_PASSWORD=ativada_live72_dev_only
POSTGRES_DB=ativada_live72
DATABASE_URL=postgres://ativada:ativada_live72_dev_only@127.0.0.1:56532/ativada_live72
API_HOST=127.0.0.1
API_PORT=56501
PANEL_PORT=56500
# Keycloak e Mailpit (valores de desenvolvimento, nao secretos)
KEYCLOAK_PORT=56580
MAILPIT_SMTP_PORT=56525
MAILPIT_UI_PORT=56526
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=ativada_live72_admin_only
KEYCLOAK_SESSION_CLIENT_SECRET=ativada_session_live72_only
KEYCLOAK_SERVICE_CLIENT_SECRET=ativada_service_live72_only
KEYCLOAK_PANEL_ORIGIN=http://127.0.0.1:56500
KEYCLOAK_ISSUER=http://127.0.0.1:56580/realms/ativada
KEYCLOAK_JWKS_URL=http://127.0.0.1:56580/realms/ativada/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://127.0.0.1:56580/realms/ativada/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URL=http://127.0.0.1:56580/realms/ativada/protocol/openid-connect/logout
KEYCLOAK_SESSION_CLIENT_ID=ativada-session
KEYCLOAK_ADMIN_API_URL=http://127.0.0.1:56580/admin/realms/ativada
KEYCLOAK_SERVICE_CLIENT_ID=ativada-api-service
SESSION_ALLOWED_REDIRECT_URIS=http://127.0.0.1:56500/auth/callback
API_AUDIENCE=ativada-api
AUTHORIZED_PARTIES=ativada-session
CORS_ALLOWED_ORIGINS=http://127.0.0.1:56500
TRUSTED_PROXY_HOPS=0
# Telegram: o token e o segredo são FALSOS e a "Bot API" é o sumidouro local (scripts/live72/telegram-sink.ts).
# O Telegram real nunca é chamado; sem token o worker não enfileira alerta nenhum (ver docs/runbook-live72.md).
TELEGRAM_BOT_TOKEN=123456789:FAKE_live72_token_only_for_local_use
TELEGRAM_WEBHOOK_SECRET=fake_live72_webhook_secret_only_0001
TELEGRAM_API_BASE_URL=http://127.0.0.1:56504
# Mercado REAL (dados públicos da Binance, sem chave): 2 anos de histórico para o aquecimento.
MARKET_EXCHANGE=binance
MARKET_SYMBOLS=BTCUSDT,ETHUSDT
MARKET_TIMEFRAMES=1h,1d
BACKFILL_YEARS=2
BINANCE_BASE_URL=https://data-api.binance.vision
FEAR_GREED_API_URL=https://api.alternative.me/fng/
FEAR_GREED_REFRESH_DAYS=14
BINANCE_STREAM_URL=wss://data-stream.binance.vision
STREAM_STALE_SECONDS=60
STREAM_GAP_LOOKBACK_HOURS=168
STREAM_GAP_CHECK_MINUTES=15
STREAM_MAX_SOCKETS_PER_USER=5
STREAM_MAX_PAIRS_PER_SOCKET=10
TICKER_STREAM_ENABLED=true
TICKER_STALE_SECONDS=10
# Usuário de teste do responsável (credencial de DESENVOLVIMENTO desta infra descartável).
LIVE72_USERNAME=live72-responsavel
LIVE72_USER_EMAIL=live72-responsavel@example.test
LIVE72_USER_PASSWORD=Live72-Dev-Only-Pass-2026!
